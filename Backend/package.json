{
  "name": "coalgov-backend",
  "version": "1.0.0",
  "description": "Governance and compliance platform for Indian coal mining operations",
  "main": "src/index.js",
  "scripts": {
    "predev": "prisma generate",
    "dev": "nodemon src/index.js",
    "prestart": "prisma generate",
    "start": "node src/index.js",
    "postinstall": "prisma generate",
    "setup": "prisma generate && node src/config/setupDb.js",
    "db:setup": "prisma generate && node src/config/setupDb.js",
    "db:start": "node -e \"require('./src/config/dbLauncher').ensurePostgresRunning().then(()=>console.log('PostgreSQL ready')).catch(console.error)\"",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "coalgov",
    "compliance",
    "governance",
    "mining",
    "express",
    "javascript",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^4.21.1",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.13",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
