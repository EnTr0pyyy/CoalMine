// CoalGov Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String?  @unique
  email        String   @unique
  password     String
  name         String
  role         String   @default("department_officer") // corporate_admin, mine_manager, safety_officer, field_inspector, contractor, regulator, department_officer
  department   String?  // system, production, safety_rescue, etc.
  contractorId String?  // C-101, contractor-1 etc.
  phone        String?
  mineName     String?  // Associated mine/block name if applicable
  designation  String?  // Official designation / title
  refreshToken String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chatSessions   ChatSession[]
  documents      Document[]      @relation("DocumentOwner")
  workspaceTasks WorkspaceTask[]
  automations    Automation[]

  @@map("users")
}

model Mine {
  id                    String   @id @default(uuid())
  code                  String?  @unique // e.g. MINE-JH-001
  name                  String
  subsidiary            String?  // e.g. ECL, BCCL, CCL, WCL, SECL, MCL, NCL
  state                 String?
  district              String?
  location              String?
  latitude              Float?
  longitude             Float?
  operationalStatus     String   @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED
  complianceRate        Float    @default(0)
  riskScore             Float    @default(0)
  riskLevel             String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  openFlags             Int      @default(0)
  openCorrectiveActions Int      @default(0)
  coordinates           Json?    // [lat, lng]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("mines")
}

model Flag {
  id                String   @id @default(uuid()) // e.g. F-1021
  category          String   // Safety, Environment, Labour, Equipment, Administrative, Compliance, Other
  mineId            String?
  mineName          String?
  location          String?
  description       String
  severity          String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status            String   @default("New") // New, Under Review, Assigned, Investigation, Action Required, Action Taken, Resolved, Dismissed, Closed
  assignedAuthority String?  @default("Unassigned")
  reporterType      String?  // Inspector, Worker, Drone, IoT Sensor, Public
  isConfidential    Boolean  @default(false)
  reporterName      String?
  evidenceCount     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("flags")
}

model Response {
  id                  String   @id @default(uuid()) // e.g. R-501
  flagId              String
  authority           String
  responseType        String   // Issue Approved, Action Initiated, Action Taken, Resolved, Dismissed
  status              String   @default("Open")
  date                DateTime @default(now())
  officialResponse    String
  actionTaken         String?
  reason              String?
  supportingDocuments Json?    // Array of string URLs / names
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("responses")
}

model CorrectiveAction {
  id             String   @id @default(uuid()) // e.g. CA-1042
  flagId         String?
  issue          String
  recommendation String
  mineId         String?
  mineName       String?
  assignedTo     String
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  dueDate        String?
  status         String   @default("Open") // Open, Assigned, In Progress, Submitted for Verification, Verified, Closed, Rejected
  isOverdue      Boolean  @default(false)
  evidence       Json?    // Array of string URLs
  comments       Json?    // Array of { id, author, text, timestamp }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("corrective_actions")
}

model ComplianceRequirement {
  id                String   @id @default(uuid()) // e.g. CR-001
  requirement       String
  mineId            String?
  mineName          String?
  category          String   // Safety, Environment, Labour, Equipment, Training, Emergency, Statutory Reporting
  regulationRef     String?
  description       String?
  frequency         String?
  responsiblePerson String?
  dueDate           String?
  status            String   @default("Compliant") // Compliant, Due Soon, Overdue, Non-Compliant
  evidence          Json?    // Array of strings
  history           Json?    // Array of { date, action, by }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("compliance_requirements")
}

model Inspection {
  id             String   @id @default(uuid()) // e.g. INS-1024
  mineId         String?
  mineName       String?
  inspector      String?
  inspectionType String   @default("Statutory Inspection") // Safety Audit, Statutory Inspection, Environmental Audit, Equipment Check, Routine Walkthrough
  date           String?
  status         String   @default("Scheduled") // Scheduled, In Progress, Completed
  riskLevel      String?
  checklist      Json?    // Array of strings
  observations   Json?    // Array of observation objects
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("inspections")
}

model Contractor {
  id              String   @id @default(uuid()) // e.g. contractor-1
  name            String
  primaryMineId   String?
  primaryMineName String?
  workers         Int      @default(0)
  complianceRate  Float    @default(0)
  riskLevel       String   @default("LOW") // LOW, MEDIUM, HIGH
  riskScore       Float    @default(0)
  openActions     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("contractors")
}

model ContractorProject {
  id           String   @id @default(uuid())
  contractorId String
  name         String
  mineId       String?
  mineName     String?
  status       String   @default("Active")
  startDate    String?
  endDate      String?
  compliance   Float    @default(0)
  budget       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("contractor_projects")
}

model ContractorReport {
  id               String    @id @default(uuid()) // e.g. CR-501
  contractorId     String
  reportType       String
  projectId        String?
  projectName      String?
  reportDate       String?
  comment          String?
  document         Json?     // { name, size, type }
  processingStatus String    @default("Uploaded") // Uploaded, Processing, OCR Completed
  reportStatus     String    @default("Draft") // Draft, Under Review, Submitted, Approved, Rejected
  submittedDate    DateTime?
  extractedData    Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("contractor_reports")
}

model ContractorAttendance {
  id           String   @id @default(uuid())
  contractorId String
  date         String
  workers      Int      @default(0)
  present      Int      @default(0)
  absent       Int      @default(0)
  shift        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("contractor_attendance")
}

model ContractorSafetyRequirement {
  id           String   @id @default(uuid())
  contractorId String
  requirement  String
  status       String
  expiryDate   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("contractor_safety_requirements")
}

model ContractorDocument {
  id           String   @id @default(uuid())
  contractorId String
  name         String
  type         String
  uploadedDate String?
  size         String?
  status       String   @default("Verified")
  fileUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("contractor_documents")
}

model RiskNotification {
  id           String   @id @default(uuid())
  contractorId String?
  date         String?
  delta        Int?     @default(0)
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("risk_notifications")
}

model ContractorPerformance {
  id               String   @id @default(uuid())
  contractorId     String   @unique
  safetyCompliance Float    @default(0)
  taskCompletion   Float    @default(0)
  inspectionScore  Float    @default(0)
  documentation    Float    @default(0)
  overall          Float    @default(0)
  updatedAt        DateTime @updatedAt

  @@map("contractor_performance")
}

model Document {
  id            String   @id @default(uuid())
  userId        String?
  name          String
  fileType      String?
  mineId        String?
  mineName      String?
  status        String   @default("Processing") // Processing, Processed
  uploadedDate  DateTime @default(now())
  extractedData Json?
  fileUrl       String?
  isImmutable   Boolean  @default(true)
  currentVersionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User?             @relation("DocumentOwner", fields: [userId], references: [id], onDelete: SetNull)
  versions      DocumentVersion[]
  chatLinks     ChatDocument[]
  workspaceTasks WorkspaceTask[]

  @@index([userId])

  @@map("documents")
}

model Notice {
  id            String    @id @default(uuid())
  refNo         String?
  title         String
  description   String
  category      String
  priority      String    @default("MEDIUM")
  authority     String?
  publishedDate DateTime  @default(now())
  expiryDate    DateTime?
  status        String    @default("Active")
  visibility    Json      // "All Departments" or array of department strings
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("notices")
}

model Notification {
  id        String   @id @default(uuid())
  type      String   // HIGH RISK, OVERDUE, COMPLIANCE, FLAG, AI ALERT
  message   String
  timestamp DateTime @default(now())
  read      Boolean  @default(false)
  priority  String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  actor        String
  actorType    String   @default("user") // user | system
  action       String
  entity       String
  entityId     String?
  metadata     Json?
  hash         String?  // SHA-256 cryptographic hash of this record
  previousHash String?  // SHA-256 hash of preceding audit record (blockchain link)
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}

model RiskScore {
  id            String   @id @default(uuid())
  mineId        String   @unique
  mineName      String
  score         Float
  previousScore Float?
  level         String   // LOW, MEDIUM, HIGH, CRITICAL
  trend         String   // improving, deteriorating, stable
  contributors  Json?    // [{ label, weight }]
  history       Json?    // [{ month, score }]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("risk_scores")
}

model RecurringIssue {
  id                     String   @id @default(uuid())
  issueType              String
  category               String
  occurrencesTotal       Int      @default(0)
  occurrencesLast3Months Int      @default(0)
  mineId                 String?
  mineName               String?
  contractorInvolved     String?
  riskLevel              String   @default("MEDIUM")
  recommendation         String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("recurring_issues")
}

model ChatSession {
  id           String    @id @default(uuid())
  userId       String?
  isPersistent Boolean   @default(false)
  title        String    @default("New Chat")
  activeDocumentId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages     Message[]
  documentLinks ChatDocument[]
  workspaceTasks WorkspaceTask[]

  @@index([userId, updatedAt])

  @@map("chat_sessions")
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  role      String      // "user" | "assistant" | "system"
  content   String
  sources   Json?
  createdAt DateTime    @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model DocumentChunk {
  id            String   @id @default(uuid())
  documentId    String?  @map("document_id")
  filename      String
  content       String
  embeddingJson Json?    @map("embedding_json")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("document_chunks")
}

// A chat workspace can attach the same repository document in a specific role.
// The original source stays immutable; generated/working documents are versioned below.
model ChatDocument {
  id          String   @id @default(uuid())
  sessionId   String
  documentId  String
  role        String   @default("SOURCE") // SOURCE, WORKING, GENERATED
  attachedAt  DateTime @default(now())

  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, documentId])
  @@index([documentId])
  @@map("chat_documents")
}

// Content is stored as structured report JSON as well as an optional rendered file.
// A new version is always created instead of replacing the previous one.
model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  versionNumber Int
  label         String?
  changeSummary String?
  content       Json?
  fileUrl       String?
  createdById   String?
  createdAt     DateTime @default(now())

  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@map("document_versions")
}

// Durable state for work that must keep running while the user changes routes or tabs.
model WorkspaceTask {
  id          String   @id @default(uuid())
  userId      String
  sessionId   String?
  documentId  String?
  type        String   // ANALYZE_DOCUMENT, GENERATE_REPORT, REPORT_STUDIO_GENERATE, EDIT_DOCUMENT
  status      String   @default("QUEUED") // QUEUED, READING, ANALYZING, GENERATING, VALIDATING, COMPLETED, FAILED, CANCELLED
  progress    Int      @default(0)
  currentStep String?
  payload     Json?
  result      Json?
  error       String?
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  document    Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, status, updatedAt])
  @@index([sessionId, updatedAt])
  @@map("workspace_tasks")
}

// Automation definitions are durable configuration. A worker may later execute
// these for upload or schedule triggers without changing the chat model.
model Automation {
  id        String   @id @default(uuid())
  userId    String
  name      String
  trigger   String   // DOCUMENT_UPLOADED, SCHEDULE
  action    String   // ANALYZE_DOCUMENT, GENERATE_REPORT, COMPARE_DOCUMENTS
  config    Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("automations")
}
